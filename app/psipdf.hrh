#ifndef __PSIPDF_HRH
#define __PSIPDF_HRH

enum TPpCommandIds
	{
	EPpCmdOpen = 0x1000,        // File > Open file... (Ctrl+O)
	EPpCmdDetails,              // File > Document details... (Shift+Ctrl+D)
	EPpCmdFind,                 // Edit > Find... (Ctrl+F)
	EPpCmdFindNext,             // Edit > Find next (Ctrl+J)
	EPpCmdGoTo,                 // Edit > Go to page... (Ctrl+G)
	EPpCmdNext,                 // View > Next page (Shift+Ctrl+N, Fn+Down, toolbar)
	EPpCmdPrev,                 // View > Previous page (Shift+Ctrl+B, Fn+Up, toolbar)
	EPpCmdFirst,                // View > First page (Ctrl+Fn+Up)
	EPpCmdLast,                 // View > Last page (Ctrl+Fn+Down)
	EPpCmdZoomIn,               // View > Zoom in (Ctrl+M)
	EPpCmdZoomOut,              // View > Zoom out (Shift+Ctrl+M)
	EPpCmdFitWidth,             // View > Zoom > Fit width (Ctrl+W)
	EPpCmdFitPage,              // View > Zoom > Fit page (Shift+Ctrl+W)
	EPpCmdZoom100,              // View > Zoom > 100%
	EPpCmdZoom150,              // View > Zoom > 150%
	EPpCmdZoom200,              // View > Zoom > 200%
	EPpCmdToolbar,              // View > Show toolbar (Ctrl+T)
	EPpCmdAbout,                // Tools > About PsiPDF (Shift+Ctrl+A)
	EPpCmdFileName,             // the toolbar's file name
	EPpCmdPageLabel             // the toolbar's "Page 3 of 12"
	};

enum TPpDialogIds
	{
	EPpDlgPage = 1,             // Go to page: the page
	EPpDlgPageCount,            // Go to page: "1 to 12"
	EPpDlgFindText,             // Find: the text
	EPpDlgPassword,             // Password: the password
	EPpDlgPasswordFile,         // Password: the file's name
	EPpDlgAboutName,            // About: the name and version
	EPpDlgAboutText,            // About: what it does, and the copyright line
	EPpDlgAboutMuPdf,           // About: MuPDF's line
	EPpDlgAboutSource,          // About: where the source is
	EPpDlgDetails1,             // Document details: its lines
	EPpDlgDetails2,
	EPpDlgDetails3,
	EPpDlgDetails4
	};

#endif

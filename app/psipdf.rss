	menubar=r_pp_menubar;
	hotkeys=r_pp_hotkeys;
	}                                   // (the toolbar: made for the machine at start-up, CPpAppUi::MakeToolBarL)

// The toolbars. Each has the file's name (a tap shows the open programs),
// Previous and Next page, Zoom in and Zoom out, and the clock; pictures
// from PsiPDF.mbm (pkg/mkicon.py), set at start-up.
//
// r_pp_toolbar, the Series 5mx's (240 lines): buttons of the standard
// height and no page label, so the clock keeps its room (24 + 4 x 37 + 2
// leaves 66, as the built-in programs have); the page shown is an infoprint.
RESOURCE TOOLBAR r_pp_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtFileNameLabel;
			id=EPpCmdFileName;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			},
		TBAR_BUTTON { id=EPpCmdPrev; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Back"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPpCmdNext; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Next"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPpCmdZoomIn; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Zoom\nin"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPpCmdZoomOut; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Zoom\nout"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// the netBook's (480 lines): the buttons at the netBook's 50 pixels, as
// Psion's own programs there, and the page shown ("Page 3" over "of 12")
// under them. r_pp_toolbar_nb on Psion's own image; r_pp_toolbar_coda on
// Coda's (Z:\System\Libs\PsiBattHook.bin there), with Coda's battery, gauges
// and clock under the page, as Word and Agenda have them: the types are
// made by Coda's Eikon (psion-netbook tools/battpatch.mts and toolbars.mts:
// 0x7044 the battery, 0x7042 the gauges, 0x7043 the clock). Chosen at
// start-up (CPpAppUi::ConstructL).
#define PP_NB_BUTTON_LENGTH 50
#define PP_PAGE_LABEL_LENGTH 34
#define PP_CT_CODA_GAUGES 0x7042
#define PP_CT_CODA_CLOCK 0x7043
#define PP_CT_CODA_BATTERY 0x7044

// the netBook battery's fields, as Psion's toolbars have them (Word.rsc,
// v1.05(450)); its last is a resource of the netBook's Eikon
STRUCT PP_NB_BATTERY
	{
	LONG f1=-1;
	WORD f2=10;
	BYTE f3=0;
	BYTE f4=3;
	WORD f5=0;
	BYTE f6=0;
	BYTE f7=0x18;
	BYTE f8=0;
	LLINK f9=0x00f3b1b5;
	}


// (one copy, kept the same in every Coda program: psion-netbook psisys/ is the master)
// psihelp.rssi: the Help dialog's resource (psihelp.h), included by each Coda
// program's .rss after its own resources:
//   #include <eikrted.rh> and <eikchlst.rh> (with the others)
//   #include "psihelp.hrh"   (with the program's .hrh)
//   #include "psihelp.rssi"  (at the end)
// The title ("Help on PsiFiles") is set at run time. A fixed size, as
// PsiMail's, PsiTerm's and PsiLinux's Help: 520 px wide (the text and its
// scroll bar), 7 whole lines on the 5mx's 240 lines, 12 on the netBook's
// 480: the text's line (EPsiCtHelpBox, CPsiHelpBox in psihelp.h) sizes
// itself by the screen and its own line height (21 November 2026), so the
// two resources are now the same and PSIHELP_LINES / PSIHELP_HEIGHT no
// longer change what is seen (kept, so the programs' .rss need not change).
// The editor's resource stays RTXTED: its width is the text's beside the
// bar, 495 (with the bar's 23 and the edges, the 520 the box always had).
#include <eikedwin.hrh>     // (the editor's flags; #defines, safe to include twice)
#ifndef PSIHELP_LINES
#define PSIHELP_LINES 7
#define PSIHELP_HEIGHT 118
#endif
#ifndef PSIHELP_TALL_LINES
#define PSIHELP_TALL_LINES 12
#define PSIHELP_TALL_HEIGHT 204
#endif
RESOURCE DIALOG r_psi_help_dialog
	{
	title="Help";
	flags=EEikDialogFlagWait|EEikDialogFlagNotifyEsc;
	buttons=R_EIK_BUTTONS_CONTINUE;
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="Topic"; id=EPsiHelpTopic;
			control=CHOICELIST { array_id=r_psi_help_empty; }; },
		DLG_LINE { type=EPsiCtHelpBox; prompt=""; id=EPsiHelpText;
			control=RTXTED { width=495; height=PSIHELP_HEIGHT; numlines=PSIHELP_LINES; textlimit=6000; flags=EEikEdwinNoAutoSelection|EEikEdwinReadOnly; }; }
		};
	}

RESOURCE DIALOG r_psi_help_dialog_tall
	{
	title="Help";
	flags=EEikDialogFlagWait|EEikDialogFlagNotifyEsc;
	buttons=R_EIK_BUTTONS_CONTINUE;
	items=
		{
		DLG_LINE { type=EEikCtChoiceList; prompt="Topic"; id=EPsiHelpTopic;
			control=CHOICELIST { array_id=r_psi_help_empty; }; },
		DLG_LINE { type=EPsiCtHelpBox; prompt=""; id=EPsiHelpText;
			control=RTXTED { width=495; height=PSIHELP_TALL_HEIGHT; numlines=PSIHELP_TALL_LINES; textlimit=6000; flags=EEikEdwinNoAutoSelection|EEikEdwinReadOnly; }; }
		};
	}

RESOURCE ARRAY r_psi_help_empty
	{
	items={ LBUF { txt="-"; } };
	}

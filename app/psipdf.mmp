TARGET        psipdf.app
TARGETTYPE    app
UID           0x1000006c 0x01000AD8
TARGETPATH    \system\apps\psipdf

PROJECT       ptproj
SUBPROJECT    psipdf

SOURCE        psipdf.cpp
RESOURCE      psipdf.rss

USERINCLUDE   \ptproj\psipdf
SYSTEMINCLUDE \epoc32\include

LIBRARY       euser.lib efsrv.lib apparc.lib cone.lib eikon.lib etext.lib ws32.lib gdi.lib fbscli.lib bafl.lib apgrfx.lib
